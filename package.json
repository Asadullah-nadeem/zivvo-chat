{
  "name": "zivvochat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "frontend:dev": "next dev",
    "frontend:build": "next build",
    "frontend:start": "next start",
    "frontend:lint": "eslint",
    "server:start": "nodemon --exec ts-node api/server.ts",
    "server:build": "tsc api/server.ts --esModuleInterop --skipLibCheck --module commonjs --target es6 --moduleResolution node",
    "dev:all": "concurrently \"npm run server:start\" \"npm run frontend:dev\"",
    "build:all": "npm run server:build && npm run frontend:build"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.555.0",
    "next": "16.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/express": "^5.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/socket.io": "^3.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.4",
    "nodemon": "^3.1.11",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
