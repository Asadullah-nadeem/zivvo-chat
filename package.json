{
  "name": "zivvochat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server:start\" \"npm run frontend:dev\"",
    "start": "concurrently \"npm run server:prod\" \"npm run frontend:start\"",
    "build": "npm run server:build && npm run frontend:build",
    "frontend:dev": "next dev",
    "frontend:build": "next build",
    "frontend:start": "next start",
    "frontend:lint": "eslint",
    "server:start": "nodemon --watch server --watch lib --exec ts-node --project tsconfig.server.json server/index.ts",
    "server:prod": "node dist/server/index.js",
    "server:build": "tsc --project tsconfig.server.json",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev:all": "npm run dev",
    "build:all": "npm run build"
  },
  "onlyBuiltDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.555.0",
    "next": "16.0.4",
    "pg": "^8.13.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/express": "^5.0.5",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.11.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/socket.io": "^3.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.4",
    "nodemon": "^3.1.11",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
